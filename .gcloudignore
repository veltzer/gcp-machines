# What `gcloud run deploy --source .` uploads to Cloud Build: only the
# Dockerfile and what it COPYs (pyproject.toml, uv.lock, src/) need to go up.

# ignore everything that .gitignore ignores
#!include:.gitignore

/config
/doc
/scripts
/support
/tera.templates
/tests
/LICENSE
/README.md
/package.json
/package-lock.json
/.??*
